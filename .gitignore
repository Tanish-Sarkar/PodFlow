cat > .gitignore <<'EOF'
# Environment
.env
.env.*
!.env.example
!.env.test
!.env.test.example

# Secrets / credentials
credentials/
*.pem
*.key
*.p12
*.pfx
*credentials*.json
*secret*.json
*token*.json

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
.envrc

# Node
node_modules/
.next/
out/
dist/
.turbo/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Test artifacts
coverage/
playwright-report/
test-results/

# Local data
tmp/
data/
EOF